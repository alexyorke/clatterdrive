<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <SystemCollector Id="HttpSystemCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="HttpSystemProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
      </Keywords>
    </SystemProvider>
    <Profile Id="HttpStorage.Light.File" Name="HttpStorage"
             Description="Bounded HTTP file and disk timing capture"
             LoggingMode="File" DetailLevel="Light">
      <Collectors>
        <SystemCollectorId Value="HttpSystemCollector">
          <SystemProviderId Value="HttpSystemProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
